{
  "expo": {
    "name": "Milan Explorer",
    "slug": "milan-explorer",
    "version": "1.0.0",
    "scheme": "milanexplorer",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14181C"
    },
    "android": {
      "package": "com.milanexplorer.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#14181C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      ["expo-splash-screen", { "backgroundColor": "#14181C", "image": "./assets/splash-icon.png", "imageWidth": 160 }],
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "Milan Explorer only uses your location when you tap the locate button, to show places near you. It never tracks you in the background.",
        "locationWhenInUsePermission": "Milan Explorer only uses your location when you tap the locate button, to show places near you.",
        "isAndroidBackgroundLocationEnabled": false
      }],
      ["expo-image-picker", {
        "photosPermission": "Milan Explorer only opens your photos when you choose to attach one to a visit.",
        "cameraPermission": "Milan Explorer only opens the camera when you choose to take a photo for a visit."
      }],
      ["expo-build-properties", { "android": { "minSdkVersion": 24 } }],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": { "typedRoutes": false }
  }
}
